{
  "base_branch": "",
  "branch_prefix": "factory/",
  "orchestrator": "claude",
  "max_fix_rounds": 2,
  "claude_model": "opus",
  "claude": {
    "executable": "",
    "model": "",
    "args": [
      "--permission-mode",
      "acceptEdits"
    ],
    "timeout_minutes": 45
  },
  "workers": {
    "mode": "parallel-worktrees",
    "assignment": "balanced-independent-work-units",
    "codex": true,
    "claude": true
  },
  "worktrees": {
    "root": ".project-init/worktrees",
    "integration": "integration",
    "codex": "codex",
    "claude": "claude"
  },
  "codex": {
    "model": "",
    "args": [
      "--full-auto"
    ],
    "timeout_minutes": 45
  },
  "reviewers": [
    "security",
    "code",
    "ux",
    "ui"
  ],
  "skip_ui_reviewers_when_no_ui": true,
  "merge_mode": "pr",
  "auto_merge_low_risk": false,
  "high_risk_paths": [
    "**/auth/**",
    "**/*auth*",
    "**/login*",
    "**/session*",
    "**/migrations/**",
    "**/*.sql",
    "**/schema.prisma",
    "**/billing/**",
    "**/*stripe*",
    "**/payments/**",
    "**/webhooks/**",
    "**/permissions/**",
    "**/*rbac*",
    "**/*policy*",
    "**/rls/**",
    "**/.env*",
    "**/secrets/**",
    "**/*secret*",
    "**/*.pem",
    "**/*.key",
    ".github/workflows/**",
    "**/Dockerfile",
    "**/infra/**",
    "**/*.tf",
    "**/*.bicep",
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "requirements*.txt",
    "pyproject.toml"
  ],
  "test_command": "",
  "spec_kit_dir": "specs",
  "constitution": ".specify/memory/constitution.md"
}
